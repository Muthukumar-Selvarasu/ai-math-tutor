# ==============================================================================
# SolvePath (.env.example)
# Environment Configuration Template for AI Math Tutor
# ==============================================================================
# Source: PRD §16.2, TECHNICAL.md §2.4, SPEC.md §5.8-§5.10, AGENTS.md §1-§3
#
# Rules:
# - NEVER commit secrets or .env / .env.local to version control.
# - Copy this file to .env.local for local overrides and secrets.
# - In Vercel, configure runtime secrets under Project Settings -> Environment Variables.
# - Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Core Runtime
# ------------------------------------------------------------------------------

# Environment name: development | preview | production
# - development: local machine and dev database
# - preview: PR preview deployments (Deferred to Tier 3)
# - production: live deployment (uses synthetic data only in Tier 1)
APP_ENV=development

# Session lease duration in seconds (Fixed at 12).
# Must exceed orchestrator hard stop (7.5s + 200ms) and be under Vercel maxDuration.
SESSION_LEASE_SECONDS=12

# Retention policy version stamped on records (SPEC §5.10, DESIGN §3.8)
RETENTION_POLICY_VERSION=1.0


# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Note: Slice 0 does NOT require Postgres. Local development at Tier 1a connects
# directly to a Neon development database branch (no local Docker container).

# Pooled PostgreSQL connection string for API request handlers (PgBouncer / port 6543)
# [SECRET] Used by: api (and mcp, safety from Phase B)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Direct unpooled PostgreSQL connection string for Alembic migrations (port 5432)
# [SECRET] Used by: api (migrations / CI)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require


# ------------------------------------------------------------------------------
# 3. LLM Providers & Credentials
# ------------------------------------------------------------------------------

# LLM Provider selection: gemini (default) | openrouter | vllm
LLM_PROVIDER=gemini

# Google AI Studio API key (Required for Slice 0 & live smoke test)
# [SECRET] Used by: api (and safety from Phase B)
GOOGLE_API_KEY=

# (Alternative) Vertex AI configuration if not using AI Studio API key:
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# OpenRouter API Key (Required only if LLM_PROVIDER=openrouter)
# [SECRET] Used by: api
OPENROUTER_API_KEY=

# vLLM Base URL (Required only if LLM_PROVIDER=vllm)
# OpenAI-compatible endpoint, e.g., http://localhost:8000/v1
VLLM_BASE_URL=http://localhost:8000/v1


# ------------------------------------------------------------------------------
# 4. Agent Models & Dialogue Configuration
# ------------------------------------------------------------------------------

# Socratic Dialogue Agent (AG-08) model identifier
MODEL_TUTOR=gemini-2.5-flash

# Misconception Classifier Agent (AG-06) model identifier
MODEL_CLASSIFIER=gemini-2.5-flash

# Safety Guard (AG-10) model identifier (fast, low-latency evaluator)
MODEL_SAFETY=gemini-2.5-flash-8b

# Embedding model for vector retrieval (Tier 1b onward)
MODEL_EMBEDDING=text-embedding-004

# Dialogue Mode: template | llm
# - template: [SHIPPED DEFAULT - Cut 1a-3] Authored probe text only, zero LLM calls on student path.
# - llm: Opt-in stretch mode invoking AG-06 (Classifier), AG-08 (Dialogue), and AG-10 (Safety Guard).
DIALOGUE_MODE=template

# Upper bound for LLM model and tool calls in seconds (AGENTS §2.8-§2.12)
LLM_TIMEOUT_SECONDS=2.0

# Gemini thinking budget in tokens.
# FIXED AT 0 (thinking disabled) for all agent calls to control latency and token costs.
LLM_THINKING_BUDGET=0

# Active hint policy engine version stamped on each turn
HINT_POLICY_VERSION=1.0

# Version of policy thresholds (e.g. 0.80 classifier confidence threshold) stamped on turns
POLICY_CONFIG_VERSION=1.0


# ------------------------------------------------------------------------------
# 5. Prompts & Observability (Langfuse)
# ------------------------------------------------------------------------------

# Prompt storage source: repo | langfuse
# - repo: [Tier 1a default] Versioned files under apps/api/app/prompts/
# - langfuse: [Tier 1b onward] Managed and versioned prompts in Langfuse Cloud
PROMPT_SOURCE=repo

# Pinned prompt label to fetch when PROMPT_SOURCE=langfuse (e.g. development, production)
LANGFUSE_PROMPT_LABEL=development

# Langfuse Cloud Host URL
LANGFUSE_HOST=https://cloud.langfuse.com

# Langfuse project credentials (Tier 1b onward; optional for Slice 0 / Tier 1a)
# [SECRET] Used by: api
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=


# ------------------------------------------------------------------------------
# 6. Authentication & Identity (Clerk)
# ------------------------------------------------------------------------------

# Clerk JWT Issuer URL (e.g., https://clerk.your-domain.com or https://verb-noun-00.clerk.accounts.dev)
AUTH_ISSUER=https://verb-noun-00.clerk.accounts.dev

# Clerk JSON Web Key Set URL (JWKS endpoint used by API to verify signatures)
CLERK_JWKS_URL=https://verb-noun-00.clerk.accounts.dev/.well-known/jwks.json

# Authorized Parties (azp claim): Allow-list of exact web origins (no wildcards).
# Comma-separated list. Development must include local web origin.
AUTH_AUTHORIZED_PARTIES=http://localhost:3000

# Optional audience (aud claim) check. Leave empty unless a custom Clerk JWT template sets aud.
AUTH_AUDIENCE=

# Clerk Backend API secret key (sk_test_... or sk_live_...)
# [SECRET] Used by: api
CLERK_SECRET_KEY=

# Clerk user id of the initial bootstrap administrator (used ONLY by scripts/seed_synthetic.py)
# Note: The API runtime never reads this variable.
BOOTSTRAP_ADMIN_CLERK_ID=


# ------------------------------------------------------------------------------
# 7. Internal Service Authentication & Cron
# ------------------------------------------------------------------------------

# 32+ character HMAC shared secret for signing tokens between API and solvepath-mcp (Phase B)
# [SECRET] Used by: api, mcp
INTERNAL_SERVICE_TOKEN_MCP=

# 32+ character HMAC shared secret for signing tokens between API and solvepath-safety (Phase B)
# [SECRET] Used by: api, safety
INTERNAL_SERVICE_TOKEN_SAFETY=

# Bearer token for authenticating Vercel Cron requests (e.g. /api/cron/insight-drafts)
# [SECRET] Used by: api
CRON_SECRET=


# ------------------------------------------------------------------------------
# 8. Storage (Vercel Blob)
# ------------------------------------------------------------------------------

# Vercel Blob read/write token for diagram asset rendering and storage
# [SECRET] Used by: api
BLOB_READ_WRITE_TOKEN=


# ------------------------------------------------------------------------------
# 9. Error Monitoring (Sentry)
# ------------------------------------------------------------------------------

# Sentry DSN for backend Python services (apps/api, mcp, safety)
SENTRY_DSN=

# Sentry DSN for frontend browser application (Next.js client-side)
NEXT_PUBLIC_SENTRY_DSN=

# Sentry Auth Token for uploading source maps at build time (CI / deployment only)
# [SECRET] Build-time only; never exposed at runtime or prefixed NEXT_PUBLIC_
SENTRY_AUTH_TOKEN=


# ------------------------------------------------------------------------------
# 10. Frontend Configuration (apps/web - Next.js)
# ------------------------------------------------------------------------------

# API Base URL reached by frontend (browser/Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Clerk Frontend Publishable Key (pk_test_... or pk_live_...)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
